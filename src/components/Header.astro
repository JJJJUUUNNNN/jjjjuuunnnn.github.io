---
import { SITE_TITLE } from '../consts'
import HeaderLink from './HeaderLink.astro'
---

<header>
  <nav>
    <h2>
      <a href="/">{SITE_TITLE}</a>
    </h2>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/tags/">Tags</HeaderLink>
      <HeaderLink href="/search/">Search</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <button id="theme-toggle" type="button" aria-label="暗色模式" aria-pressed="false"> 暗色模式 </button>
    </div>
    <div class="social-links">
      <a href="https://github.com/JJJJUUUNNNN" target="_blank" rel="noopener noreferrer"> GitHub ↗ </a>
      <a href="/rss.xml">RSS</a>
    </div>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle')
  const root = document.documentElement
  const systemTheme = window.matchMedia('(prefers-color-scheme: dark)')
  let userSelected = false

  try {
    const savedTheme = localStorage.getItem('blog-theme')
    userSelected = savedTheme === 'light' || savedTheme === 'dark'
  } catch {}

  function updateButton() {
    const isDark = root.dataset.theme === 'dark'
    button?.setAttribute('aria-pressed', String(isDark))
  }

  updateButton()

  button?.addEventListener('click', () => {
    const theme = root.dataset.theme === 'dark' ? 'light' : 'dark'
    root.dataset.theme = theme
    userSelected = true

    try {
      localStorage.setItem('blog-theme', theme)
    } catch {}

    updateButton()
  })

  systemTheme.addEventListener('change', (event) => {
    if (!userSelected) {
      root.dataset.theme = event.matches ? 'dark' : 'light'
      updateButton()
    }
  })
</script>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    /* background: white; */
    background: var(--header-bg);
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    /* color: var(--black); */
    color: rgb(var(--black));
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
  .internal-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 720px) {
    nav {
      flex-wrap: wrap;
    }
  }

  #theme-toggle {
    margin: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgb(var(--gray));
    border-radius: 8px;
    background: var(--header-bg);
    color: rgb(var(--black));
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  #theme-toggle:hover {
    background: rgb(var(--gray-light));
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .social-links {
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
</style>
