---
import { getCollection } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

const latestPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3)

const topics = ['前端工程', 'TypeScript', 'Astro', '交互式内容']
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <section class="intro" aria-labelledby="intro-title">
        <p class="eyebrow">JUN / 开发与记录</p>
        <h1 id="intro-title">你好，我是 Jun。</h1>
        <p class="description">在这里记录前端工程实践、技术探索和个人作品， 把学习过程整理成文章，把想法做成可以体验的演示。</p>

        <div class="intro-links">
          <a class="primary-link" href="/blog/">阅读文章 →</a>
          <a href="https://github.com/JJJJUUUNNNN" target="_blank" rel="noopener noreferrer"> GitHub ↗ </a>
        </div>
      </section>

      <section aria-labelledby="topics-title">
        <h2 id="topics-title">关注方向</h2>
        <ul class="topics">
          {topics.map((topic) => <li>{topic}</li>)}
        </ul>
      </section>

      <section aria-labelledby="projects-title">
        <h2 id="projects-title">精选项目</h2>

        <article class="project">
          <h3>这个技术博客</h3>
          <p>使用 Astro、TypeScript 和 MDX 构建。 支持全文搜索、文章标签、目录、评论与主题切换， 通过 GitHub Actions 自动部署到 GitHub Pages。</p>
          <div class="project-links">
            <a href="https://github.com/JJJJUUUNNNN/jjjjuuunnnn.github.io" target="_blank" rel="noopener noreferrer"> 查看源码 ↗ </a>
            <a href="/blog/using-mdx/">体验交互演示 →</a>
          </div>
        </article>
      </section>

      <section aria-labelledby="latest-title">
        <div class="section-heading">
          <h2 id="latest-title">最新文章</h2>
          <a href="/blog/">全部文章 →</a>
        </div>

        {
          latestPosts.length > 0 ? (
            <ul class="posts">
              {latestPosts.map((post) => (
                <li>
                  <article>
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <h3>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h3>
                    <p class="post-description">{post.data.description}</p>
                  </article>
                </li>
              ))}
            </ul>
          ) : (
            <p>第一篇文章正在路上。</p>
          )
        }
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  main {
    width: 960px;
    box-sizing: border-box;
  }

  section + section {
    margin-top: 3rem;
  }

  .intro {
    padding: 2rem 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 4rem);
  }

  .description {
    max-width: 38rem;
    color: rgb(var(--gray));
  }

  .intro-links,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .intro-links {
    margin-top: 1.5rem;
  }

  .primary-link {
    padding: 0.65rem 1rem;
    border-radius: 8px;
    background: var(--accent);
    color: var(--page-bg);
    text-decoration: none;
  }

  .primary-link:hover {
    background: var(--accent-dark);
    color: var(--page-bg);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  h3 {
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .topics,
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topics li {
    padding: 0.35rem 0.8rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 999px;
    font-size: 0.875rem;
  }

  .project {
    padding: 1.5rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
    background: var(--header-bg);
  }

  .project p {
    color: rgb(var(--gray));
  }

  .project-links {
    font-size: 0.9rem;
  }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
  }

  .section-heading > a {
    font-size: 0.875rem;
  }

  .posts li {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgb(var(--gray-light));
  }

  .posts li:first-child {
    padding-top: 0;
  }

  .posts h3 a {
    color: rgb(var(--black));
    text-decoration: none;
  }

  .posts h3 a:hover {
    color: var(--accent);
  }

  .date {
    margin: 0 0 0.4rem;
    color: rgb(var(--gray));
    font-size: 0.875rem;
  }

  .post-description {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 1rem;
  }

  @media (max-width: 720px) {
    .intro {
      padding: 1rem 0;
    }

    section + section {
      margin-top: 2rem;
    }
  }
</style>
